@{
    ViewData["Title"] = "Payment Success";
}

<div class="container text-center py-5 my-5">
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 120px;"></i>
    </div>

    <h1 class="display-4 fw-bold text-success mb-3">Payment Successful!</h1>
    <p class="lead text-muted mb-4">@ViewBag.Message</p>

    @if (!string.IsNullOrEmpty(ViewBag.CustomerEmail))
    {
        <div class="alert alert-info d-inline-block">
            <i class="bi bi-envelope"></i> A confirmation email has been sent to <strong>@ViewBag.CustomerEmail</strong>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.AmountPaid))
    {
        <div class="card border-0 shadow-sm d-inline-block mt-3 mb-4" style="min-width: 100px;">
            <div class="card-body">
                <h5 class="card-title text-muted mb-2">Amount Paid</h5>
                <h2 class="fw-bold text-success mb-0">@ViewBag.AmountPaid</h2>
            </div>
        </div>
    }

    <div class="mt-4">
        <a href="/Merchandise/Index" class="btn btn-primary btn-lg px-5 me-2">
            <i class="bi bi-shop"></i> Continue Shopping
        </a>
        <a href="/" class="btn btn-outline-secondary btn-lg px-5">
            <i class="bi bi-house"></i> Return to Home
        </a>
    </div>
</div>
