@model Zoolirante.ViewModels.DefaultViewModel
@{
    ViewData["Title"] = "Your Cart";
    var au = System.Globalization.CultureInfo.GetCultureInfo("en-AU");
}

@if (!string.IsNullOrEmpty(Model.username))
{
    <div class="w-100 bg-dark py-2 text-white d-flex justify-content-between fixed-top" style="margin-top:70px; z-index:4;">
        @if (Model.admin == true)
        {
            <p class="mb-0 fw-light ms-3">Admin Privileges Enabled</p>
        }
        <p class="mb-0 fw-light">Welcome, @Model.username</p>
        <a asp-action="Index" class="mb-0 fw-light me-3 text-light"><i class="bi bi-arrow-left"></i> Return to Merch</a>
    </div>
}

<div class="w-100 bg-dark py-5 text-white text-center" style="margin-top:-2px;">
    <h1 class="display-4 title-fade fw-bold">Your Cart</h1>
</div>


<div class="container-fluid px-5 py-5">
    @if (Model.temporaryCart == null || !Model.temporaryCart.Any())
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-bag-x display-3 text-muted"></i>
            <h4 class="mt-3">Your cart is empty</h4>
            <p class="text-muted mb-4">Looks like you haven't added anything yet.</p>
            <a asp-action="Index" class="btn btn-lg btn-dark px-4 py-2">Browse Merchandise</a>
        </div>
    }
    else
    {
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow radius-3">
                    <div class="card-body p-2">
                        <div class="list-group list-group-flush">

                            @foreach (var line in Model.temporaryCart)
                            {
                                var lineTotal = line.UnitPrice * line.Quantity;
                                <div class="list-group-item py-4 px-3">
                                    <div class="row align-items-center gy-3">
                                        <div class="col-12 col-sm-3 col-md-2 text-center">
                                            <div class="ratio ratio-1x1 rounded border bg-light overflow-hidden">
                                                <img src="@(line.Item?.ItemImage ?? "/images/placeholder.png")"
                                                     alt="@line.Item?.ItemName"
                                                     class="w-100 h-100"
                                                     style="object-fit:cover;">
                                            </div>
                                        </div>

                                        <div class="col-12 col-sm-5 col-md-5">
                                            <h5 class="fw-semibold mb-1">
                                                <a asp-action="Details"
                                                   asp-controller="Merchandise"
                                                   asp-route-id="@line.ItemId"
                                                   class="text-decoration-none text-dark hover-link">
                                                    @line.Item?.ItemName
                                                </a>
                                            </h5>
                                            <div class="text-muted">@line.UnitPrice.ToString("C", au) each</div>
                                        </div>

                                        <!-- ✅ Quantity controls (plus/minus) -->
                                        <div class="col-12 col-sm-3 col-md-3 mt-3 mt-sm-0">
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center justify-content-sm-start align-items-center gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemId" value="@line.ItemId" />
                                                <div class="btn-group" role="group" aria-label="Quantity controls">
                                                    <button name="delta" value="-1" type="submit"
                                                            class="btn btn-outline-dark btn-lg"
                                                            @(line.Quantity <= 1 ? "disabled" : "")
                                                            aria-label="Decrease quantity">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <span class="btn btn-light btn-lg disabled" aria-live="polite">@line.Quantity</span>
                                                    <button name="delta" value="1" type="submit"
                                                            class="btn btn-outline-dark btn-lg"
                                                            aria-label="Increase quantity">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </form>
                                        </div>

                                        <div class="col-12 col-sm-2 col-md-2 text-end mt-3 mt-sm-0">
                                            <div class="fw-bold fs-4">@lineTotal.ToString("C", au)</div>
                                            <form asp-action="Cart" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemToDel" value="@line.ItemId" />
                                                <button type="submit" class="btn btn-link text-danger p-0 small mt-2">
                                                    <i class="bi bi-trash"></i> Remove
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="card-footer bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap">
                        <a asp-action="Index" class="btn btn-outline-dark btn-lg px-4">
                            <i class="bi bi-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="position-sticky" style="top: 100px;">
                    <div class="card border-0 shadow radius-3">
                        <div class="card-body p-4">
                            <h4 class="card-title mb-4 fw-semibold">Order Summary</h4>

                            <div class="d-flex justify-content-between mb-3 fs-5">
                                <span class="text-muted">Items (@Model.temporaryCart.Sum(i => i.Quantity))</span>
                                <span>@Model.temporaryCart.Sum(i => i.UnitPrice * i.Quantity).ToString("C", au)</span>
                            </div>

                            <hr class="my-4" />
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="fw-bold fs-5">Total</span>
                                <span class="fs-4 fw-bold text-success">
                                    @Model.temporaryCart.Sum(i => i.UnitPrice * i.Quantity).ToString("C", au)
                                </span>
                            </div>

                            <form asp-action="Checkout" method="post" class="d-grid">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn bg-zoolirante text-white btn-lg py-3">
                                    Proceed to Payment
                                </button>
                            </form>

                            <p class="text-muted small mt-3 mb-0 text-center">
                                Secure checkout • Prices in AUD
                            </p>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    }
</div>