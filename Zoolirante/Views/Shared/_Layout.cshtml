<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zoolirante</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/StyleSheet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zoolirante.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/mobile.css" media="(max-width: 768px)" />


</head>
<body>
    <header class="mt-5">
        <nav class="navbar navbar-expand-lg navbar-light bg-zoolirante box-shadow fixed-top" style="z-index:5">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/Images/logo.png" alt="Zoolirante" class="img-fluid" style="height:40px;">
                </a>

                <!-- Mobile toggler -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Offcanvas menu on mobile, inline on desktop -->
                <div class="offcanvas offcanvas-end bg-zoolirante" tabindex="-1" id="mainNav" aria-labelledby="mainNavLabel">
                    <div class="offcanvas-header d-lg-none">
                        <h5 id="mainNavLabel" class="mb-0">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>

                    <div class="offcanvas-body">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <li class="nav-item"><a class="nav-link py-2 px-3" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link py-2 px-3" asp-controller="AnimalList" asp-action="Index">Animals</a></li>
                            <li class="nav-item"><a class="nav-link py-2 px-3" asp-controller="Events" asp-action="Index">Events</a></li>
                            <li class="nav-item"><a class="nav-link py-2 px-3" asp-controller="Tickets" asp-action="Index">Tickets</a></li>
                            <li class="nav-item"><a class="nav-link py-2 px-3" asp-controller="Merchandise" asp-action="Index">Merch</a></li>

                            @* Cart (only when items exist) *@
                            @{
                                var cartCount = Context.Session.GetInt32("CartCount") ?? 0;
                            }
                            @if (cartCount > 0)
                            {
                                <li class="nav-item position-relative">
                                    <a class="nav-link d-flex align-items-center py-2 px-3 position-relative"
                                       asp-controller="Merchandise" asp-action="Cart" aria-label="View cart">
                                        <i class="bi bi-cart3 me-1" style="font-size:1.6rem;"></i>
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                              style="font-size:.7rem; transform:translate(-35%,-40%) !important;">
                                            @cartCount
                                        </span>
                                    </a>
                                </li>
                            }

                            <li class="nav-item my-2 my-lg-0">
                                <a class="btn bg-zoolirante-secondary text-dark radius-2 shadow w-100 w-lg-auto py-2 px-3"
                                   asp-controller="Member" asp-action="Index">
                                    Become Member
                                </a>
                            </li>

                            @if (!Context.Session.GetInt32("id").HasValue || Context.Session.GetInt32("id") == 0)
                            {
                                <li class="nav-item my-2 my-lg-0">
                                    <a class="btn bg-zoolirante-secondary text-dark radius-2 shadow w-100 w-lg-auto py-2 px-3"
                                       asp-controller="Account" asp-action="Index">Login</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item my-2 my-lg-0">
                                    <a class="btn text-dark radius-2 shadow w-100 w-lg-auto py-2 px-3"
                                       style="background-color:#faa5a0" asp-controller="Account" asp-action="Logout">Logout</a>
                                </li>
                            }

                            <!-- Book Now as a proper dropdown (tap-friendly) -->
                            <li class="nav-item dropdown my-2 my-lg-0">
                                <a class="btn btn-dark text-light dropdown-toggle w-100 w-lg-auto py-2 px-3"
                                   href="#" id="bookNowMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Book Now
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3" aria-labelledby="bookNowMenu">
                                    <li><a class="dropdown-item py-2" asp-controller="Tickets" asp-action="Index">Buy Tickets</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="MyAccount">My Account</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div> <!-- /offcanvas-body -->
                </div>   <!-- /offcanvas -->
            </div>
        </nav>

    </header>
    <div class="container-fluid px-0 mx-0" style="overflow-x: hidden;">
        <main role="main" class="pb-3 pt-4">
            @RenderBody()
        </main>
    </div>

    <section class="bottom-section bg-dark text-white py-4 mt-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="text-uppercase fw-bold mb-2">Location</h6>
                    <p class="mb-0 small">Somewhere in the middle of Australia</p>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="text-uppercase fw-bold mb-2">Hours</h6>
                    <p class="mb-0 small">9AM – 5PM (Weekday)</p>
                    <p class="mb-0 small">10AM – 5PM (Weekend)</p>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="text-uppercase fw-bold mb-2">Tickets & Membership</h6>
                    <a href="/Tickets/Index" class="link-light d-inline-block py-1">Buy Tickets</a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="text-uppercase fw-bold mb-2">Visit</h6>
                    <a href="/AnimalList/Index" class="link-light d-inline-block py-1">Find Animals</a><br />
                    <a href="/Merchandise/Index" class="link-light d-inline-block py-1">Visit Merch Shop</a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="text-uppercase fw-bold mb-2">Events & Experience</h6>
                    <a href="/Events/Index" class="link-light d-inline-block py-1">All Events</a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="text-uppercase fw-bold mb-2">About Us</h6>
                    <a href="/Home/Privacy" class="link-light d-inline-block py-1">Privacy</a>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <img class="img-fluid w-100 rounded-3" src="/Images/pandaBannerCropped.jpg" alt="Panda Banner" loading="lazy">
                </div>
            </div>
        </div>
    </section>


    <footer class="footer text-muted" style="background-color: #6B5B47;">
        <div class="ms-5 text-white">
            &copy; 2025 - Zoolirante - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>