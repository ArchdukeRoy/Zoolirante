@model Zoolirante.ViewModels.AccountViewModel

<div class="w-100 bg-dark py-5 text-white text-center" style="margin-top: -2px">
    <h1>MyAccount</h1>
</div>
<head>
    <link rel="stylesheet" href="~/css/MyAccount.css" />
</head>

<div class="w-100 bg-zoolirante-light py-1 shadow"></div>
<div>
    <p class="text-head" align> Hello @Model.Visitor.Username!!</p>
</div>
<div class="container">
    <div class="row">
        @*Account info*@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 mt-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <img id="profileIcon" src="https://uxwing.com/wp-content/themes/uxwing/download/peoples-avatars/account-grey-icon.png" alt="profile icon" class="profile-icon">
                    <span id="profileStatus" class="profile-text">  Account Information </span>
       

                </div>
                <div class="card-body">
                    <!-- Username -->
                    <h6 class="fw-light mb-1">Username</h6>
                    <input type="text" value="@Model.Visitor.Username" class="form-control mb-2" style="background-color: bisque;" readonly />

                    <!-- First Name -->
                    <h6 class="fw-light mb-1">First Name</h6>
                    <input type="text" value="@Model.Visitor.Username" class="form-control mb-2" style="background-color: bisque;" readonly />

                    <!-- Last Name -->
                    <h6 class="fw-light mb-1">Last Name</h6>
                    <input type="text" value="@Model.Person.LastName" class="form-control mb-2" style="background-color: bisque;" readonly />

                    <!-- Email -->
                    <h6 class="fw-light mb-1">Email</h6>
                    <div class="input-group mb-2">
                        <input id="emailField" type="password" value="@Model.Person.Email" class="form-control" style="background-color: bisque;" readonly />
                        <button type="button" class="btn btn-outline-dark" onclick="toggleField('emailField')">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <!-- Password -->
                    <h6 class="fw-light mb-1">Password</h6>
                    <div class="input-group mb-2">
                        <input id="passwordField" type="password" value="@Model.Visitor.PasswordHash" class="form-control" style="background-color: bisque;" readonly />
                        <button type="button" class="btn btn-outline-dark" onclick="toggleField('passwordField')">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <!-- Phone -->
                    <h6 class="fw-light mb-1">Phone</h6>
                    <div class="input-group mb-2">
                        <input id="phoneField" type="password" value="@Model.Visitor.Contact" class="form-control" style="background-color: bisque;" readonly />
                        <button type="button" class="btn btn-outline-dark" onclick="toggleField('phoneField')">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
     
        
        @*Fav animals*@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 mt-4">
                <div class="card-header bg-dark text-white fw-bold">
                    Favourite Animals
                </div>
                <div class="card-body">
                    @if (Model.DefaultVM.favouriteAnimals.Any()) {
                        <ul class="list-group list-group-flush" >
                            @foreach (var item in Model.DefaultVM.favouriteAnimals) {
                                <li class="list-group-item" style="background-color: bisque;">@item.AnimalName</li>
                            }
                        </ul>
                    }

                    @if (Model.DefaultVM.favouriteAnimals.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.DefaultVM.favouriteAnimals)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <strong>@item.AnimalName</strong>
                                    @if (item.AnimalId == 2)
                                    {
                                        <div> Part of the Feeding Time event!! </div>
                                        <form asp-controller="Notifications" asp-action="SendAnimalEventEmail" method="post" class="m-0 p-0">
                                            <input type="hidden" name="animalName" value="@item.AnimalName" />
                                            <input type="hidden" name="message"
                                                   value="Hey @Model.DefaultVM.firstName, the @item.AnimalName is a part of our Feeding Time event we are holding at 12:00pm on 11/10/2025! Don't miss out on seeing the animal you love and come visit Zoolirante!! 🐾" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-circle" title="Send preset message">
                                                <i class="bi bi-bell-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.AnimalId == 6)
                                    {
                                        <div> Part of the Conservation Talk!! </div>
                                        <form asp-controller="Notifications" asp-action="SendAnimalEventEmail" method="post" class="m-0 p-0">
                                            <input type="hidden" name="animalName" value="@item.AnimalName" />
                                            <input type="hidden" name="message"
                                                   value="Hey @Model.DefaultVM.firstName, the @item.AnimalName is a part of our Conservation Talk event we are holding at 10:30am on 11/10/2025! Don't miss out on seeing the animal you love and come visit Zoolirante!! 🐾" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-circle" title="Send preset message">
                                                <i class="bi bi-bell-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.AnimalId == 4)
                                    {
                                        <div> Part of the Behind the Scenes Tour!! </div>
                                        <form asp-controller="Notifications" asp-action="SendAnimalEventEmail" method="post" class="m-0 p-0">
                                            <input type="hidden" name="animalName" value="@item.AnimalName" />
                                            <input type="hidden" name="message"
                                                   value="Hey @Model.DefaultVM.firstName, the @item.AnimalName is a part of our Behind the Scenes Tour event we are holding at 03:00pm on 11/10/2025! Don't miss out on seeing the animal you love and come visit Zoolirante!! 🐾" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-circle" title="Send preset message">
                                                <i class="bi bi-bell-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.AnimalId == 10)
                                    {
                                        <div> Part of the Animal Enrichment!! </div>
                                        <form asp-controller="Notifications" asp-action="SendAnimalEventEmail" method="post" class="m-0 p-0">
                                            <input type="hidden" name="animalName" value="@item.AnimalName" />
                                            <input type="hidden" name="message"
                                                   value="Hey @Model.DefaultVM.firstName, the @item.AnimalName is a part of our Animal Enrichment event we are holding at 09:10pm on 13/10/2025! Don't miss out on seeing the animal you love and come visit Zoolirante!! 🐾" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-circle" title="Send preset message">
                                                <i class="bi bi-bell-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.AnimalId == 11)
                                    {
                                        <div> Part of the Junior Zookeeper Experience!! </div>
                                        <form asp-controller="Notifications" asp-action="SendAnimalEventEmail" method="post" class="m-0 p-0">
                                            <input type="hidden" name="animalName" value="@item.AnimalName" />
                                            <input type="hidden" name="message"
                                                   value="Hey @Model.DefaultVM.firstName, the @item.AnimalName is a part of our Junior Zookeeper Experience event we are holding at 09:15pm on 12/10/2025! Don't miss out on seeing the animal you love and come visit Zoolirante!! 🐾" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-circle" title="Send preset message">
                                                <i class="bi bi-bell-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else {<p class="text-muted">No favourite animals added yet.</p>}
                </div>
            </div>
        </div>

        @*Purchase History*@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 mt-4">
                <div class="card-header bg-dark text-white fw-bold">
                    Purchase History
                </div>
                <div class="card-body">
                    <p class="text-muted">No purchases yet.</p>
                </div>
            </div>
        </div>

        @*Visit History*@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 mt-4">
                <div class="card-header bg-dark text-white fw-bold">
                    Visit History
                </div>
                <div class="card-body">
                    <p class="text-muted">No visits recorded yet.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="notification-toggle">
                <div class="card shadow-sm border-0 h-100 mt-4">
                    <div class="card-header bg-dark text-white fw-bold">
                        <img id="profileIcon" src="https://www.citypng.com/public/uploads/preview/white-notification-bell-icon-transparent-background-701751695033958n33jtfuju8.png?v=2025083107" alt="profile icon" class="profile-icon">
                    <span id="profileStatus" class="profile-text">  Notificaiton Settings </span>
                    </div>
                    <div class="card-body d-flex align-items-center gap-2" style=">
                        <img id="bellIcon" src="https://cdn-icons-png.flaticon.com/128/1827/1827349.png" alt="Notification Bell" class="bell-icon">
                        <label class="switch">
                            <input type="checkbox">
                            <span class="slider round"></span>
                        </label>
                        <span id="notifStatus" class="notif-text">Notifications On / Off </span>
                    </div>
                </div>

            </div>
        </div>
</div>
</div>


<script>
    function toggleField(fieldId) {
        const field = document.getElementById(fieldId);
        field.type = field.type === "password" ? "text" : "password";
    }
</script>
